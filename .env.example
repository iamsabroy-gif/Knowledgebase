# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---- Phase 1: Firebase client overrides (optional) ----
# Override the values in firebase-applet-config.json so staging/prod can use
# a different Firebase project without touching committed config files.
# Leave unset to fall back to firebase-applet-config.json values.
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_APP_ID=""

# ---- Phase 2: Server-side firebase-admin (required for /api/* auth) ----
# Option A — Service Account JSON (single-line, base64 or raw):
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"..."}'
# Option B — Use Application Default Credentials (gcloud auth application-default login):
# Leave FIREBASE_SERVICE_ACCOUNT unset; ADC is used automatically.
FIREBASE_PROJECT_ID="MY_PROJECT_ID"

# Admin passcode for the admin panel (server-side only).
# Must be set to a strong value; startup will fail if left as the default.
ADMIN_PASSCODE="MY_ADMIN_PASSCODE"

# GitHub Personal Access Token for repo sync (optional stopgap).
# Fine-grained PAT, Repository Permissions -> Contents: Read and write.
# Server-side only. Never sent to or accepted from the browser.
GITHUB_TOKEN="MY_GITHUB_PAT"

# ---- GitHub App Integration (User-to-Server OAuth & Repo Sync) ----
# Register via GitHub Settings -> Developer settings -> GitHub Apps
GITHUB_APP_ID=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
GITHUB_APP_SLUG=""
# Private key in PEM format (single-line or raw with \n):
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_WEBHOOK_SECRET=""
# 32+ random characters used to sign OAuth state tokens:
GITHUB_STATE_SECRET="a_very_secure_random_state_secret_at_least_32_chars"


